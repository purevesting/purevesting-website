# .assetsignore — files that live in the repo but must NOT be published on
# purevesting.com. Same format as .gitignore. Cloudflare reads this file
# every time the site deploys.

# Hidden folders: git's full history, and your editor settings.
.git/
.claude/
.vscode/

# Notes and working files that are for you, not for visitors.
# (Delete the TODO.md line if you ever want the TODO list public.)
TODO.md
README.md
CLAUDE.md
fable-website-new-version-check.md
_template.html
og-template.html
scripts/

# Folders for planning, building and testing the site, not for visitors.
# Some don't exist yet: listing them now means nothing put in them can
# ever go live by mistake.
plan/
data/
partials/
templates/
tests/
worker/
# NSE's two files, saved by hand for the screener update on a day NSE's
# site blocks it (scripts/update_screener.py --from-folder downloads/).
downloads/

# Settings files the live site has no reason to show anyone.
wrangler.jsonc
.gitignore
.assetsignore
